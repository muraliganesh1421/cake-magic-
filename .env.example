# ==========================================
# CAKE MAGIC — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/cake_magic"

# 2. INITIAL SECURE FIRST-RUN ADMIN SETUP
# Used only during initial database seed / first-run setup.
# Never commit real credentials to Git.
INITIAL_OWNER_EMAIL="owner@cakemagic.in"
INITIAL_OWNER_NAME="Cake Magic Owner"
INITIAL_OWNER_PASSWORD="" # Set a strong temporary password before running seed

# 3. APPLICATION SECURITY
APP_SECRET="generate-a-strong-random-secret-key-at-least-32-chars"
NEXT_PUBLIC_APP_URL="https://cake-magic.vercel.app"

# 4. BUSINESS CONTACT (PROVISIONAL - OVERRIDDEN BY DATABASE BUSINESS SETTINGS)
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_STORE_ADDRESS="Rajahmundry, Andhra Pradesh"
NEXT_PUBLIC_OPENING_HOURS="Pre-orders & celebration enquiries open daily"

# 5. FUTURE PAYMENT GATEWAY (CLIENT TO CONFIRM: RAZORPAY / CASHFREE / PHONEPE)
PAYMENT_GATEWAY_PROVIDER="" # e.g. RAZORPAY
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# 6. FUTURE WHATSAPP CLOUD API (CLIENT TO CONFIGURE)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# 7. FUTURE GOOGLE SHEETS REPORTING SYNC (CLIENT TO CONFIGURE)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
